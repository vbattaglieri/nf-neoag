// ============================================================
// nf-neoag — pipeline configuration
// ============================================================

params {
    // Input / output
    input        = null                       // samplesheet CSV
    outdir       = "results"

    // netMHC-4.0 (license-restricted, bring-your-own): path to the INSTALL DIR
    netmhc       = null
    netmhc_bin   = "netMHC"                    // executable name inside that dir

    // Behaviour
    merge             = false                  // also merge SNV + Indel consensus per sample
    min_kmer          = 8                       // shortest peptide length scanned
    max_kmer          = 11                      // longest peptide length scanned
    indel_family_dist = 3                       // edit-distance for indel peptide "family" grouping

    // Reference sets are defined in conf/genomes.config (params.genomes.<build>)

    // Resource ceilings
    max_cpus     = 16
    max_memory   = '32.GB'
    max_time     = '24.h'

    // Container image (override with your published tag)
    container    = 'ghcr.io/vbattaglieri/nf-neoag:0.1.0'
}

// Reference genome definitions (hg38 / hg19 / mm10)
includeConfig 'conf/genomes.config'

// Per-process resources
includeConfig 'conf/base.config'

process {
    container = params.container
}

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    stub {
        // run with -stub-run for a dependency-free smoke test
    }
}

// Reproducibility / reporting
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" ; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html"   ; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt"     ; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html"      ; overwrite = true }

manifest {
    name            = 'nf-neoag'
    author          = 'Pipeline & Python-3 reimplementation by Vittorio Battaglieri; original method by Giuseppe Rospo (see CITATIONS.md)'
    description      = 'Neoantigen prediction from SNVs and Indels (netMHC-4 based)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '0.1.0'
}
