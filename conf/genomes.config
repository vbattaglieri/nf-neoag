// ============================================================
// Reference files per genome build.
//
// These files are LARGE and are NOT shipped with the pipeline.
// They must be provided by you (see docs/references.md):
//   cdna_tab : refFlat_mRNA.<build>.noalt.parsed.tab   (used by step 10, neo from SNVs)
//   yar      : refFlat_mRNA.<build>.yar                (used by step 11, neo from Indels)
//
// Point each entry at a local path or a URL (Nextflow will stage URLs).
// Override on the command line with e.g.:
//   --genomes.hg38.cdna_tab /data/refs/refFlat_mRNA.hg38.noalt.parsed.tab
// or by editing this file / supplying your own -c custom.config
// ============================================================

params {
    genomes {
        'hg38' {
            cdna_tab = null   // e.g. '/data/refs/hg38/refFlat_mRNA.hg38.noalt.parsed.tab'
            yar      = null   // e.g. '/data/refs/hg38/refFlat_mRNA.hg38.yar'
        }
        'hg19' {
            cdna_tab = null   // e.g. '/data/refs/hg19/refFlat_mRNA.hg19.noalt.parsed.tab'
            yar      = null   // NOTE: no hg19 .yar is currently available -> Indel step (11) unavailable for hg19
        }
        'mm10' {
            cdna_tab = null   // e.g. '/data/refs/mm10/refFlat_mRNA.mm10.noalt.parsed.tab'
            yar      = null   // e.g. '/data/refs/mm10/refFlat_mRNA.mm10.yar'
        }
    }
}
