// Minimal test profile. Intended for a dependency-free smoke test:
//   nextflow run . -profile test,docker -stub-run
// The dummy refs / netMHC below only satisfy file-existence checks;
// with -stub-run no real computation happens. For a REAL test, override
// --netmhc and the genome refs with actual files.

params {
    input      = "${projectDir}/test/samplesheet.csv"
    outdir     = "results_test"

    netmhc     = "${projectDir}/test/data/netmhc"
    netmhc_bin = "netMHC"

    merge      = true

    genomes {
        'hg38' {
            cdna_tab = "${projectDir}/test/data/refs/refFlat_mRNA.hg38.noalt.parsed.tab"
            yar      = "${projectDir}/test/data/refs/refFlat_mRNA.hg38.yar"
        }
    }

    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'
}
